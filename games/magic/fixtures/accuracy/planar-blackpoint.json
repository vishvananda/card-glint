    },
    "transition": 96,
    "proposals": [],
    "stockRgb": [24.0, 21.0, 16.0],
    "curve": "rgb + lift * max(0,1-max(rgb)/transition)^2, applied after existing HSB; alpha and all colors above transition preserved.",
    "excluded": ["Vampiric Link: existing scan normalization rejected."],
    "nativeRefitPolicy": "Fit curve coefficients using the actual composed raster response, including sampling.\nA direct 488px plate is not equivalent to the 732px inspect raster normalized to 488.\nUse the first native candidate as a linear response basis; fit calibration cards only.\n",
    "nativeFit": "Coefficients use the actual inspect render normalized to comparison size. Lower-quartile source residuals are pooled within each color; a training-only amplitude guard limits regressions. No per-card adjustments are adopted."
  },
