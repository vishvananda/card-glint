  "findings": [
    {
      "path": "early-expansion-title.ts",
      "sets": ["arn", "atq", "drk"],
      "status": "corrected",
      "finding": "Thin solid light-gray ink replaces the rejected hollow title treatment. Full native replay, three fixed crops and 84 unchanged unrelated controls certify isolation, not universal typography correctness."
    },
    {
      "path": "early-expansion-artist.ts",
      "sets": ["arn", "atq", "drk"],
      "status": "needs-recalibration",
      "finding": "Only remaining hollow text painter. Historical candidate search compared heavy solid ink with open edges; it did not provide a comparably thin gray-filled candidate. Eighteen repeated visual examples show the treatment is risky, and the new solid trial also lacks sufficient contrast on light frames. Recheck ink color and light/dark shadow or outline structure before refitting geometry. Do not automatically transfer title gray to these credits."
    },
    {
      "path": "retro-paint.ts",
      "sets": ["lea", "leb", "2ed", "leg"],
      "status": "weight-review",
      "finding": "Titles are filled rather than hollow, but representative blue and dark-frame comparisons show heavier/brighter strokes than the scan. Queue a constrained filled-ink weight/color study using their existing frozen scan poses."
    },
    {
      "path": "early-credits.ts",
      "sets": ["lea", "leb", "2ed"],
      "status": "no-hollow-path",
      "finding": "Two filled text draws provide gray lettering and a lower-right shadow. The current hollow-title code path cannot affect these credits. Small sampled visual review is not complete-set ink calibration."
    },
    {
      "path": "revised-lettering.ts",
      "sets": ["3ed"],
      "status": "no-hollow-path",
      "finding": "Title, illustrator and P/T remain filled gray with a shadow. Revised land lettering uses the same filled painter. No recurrence of the removed hollow P/T treatment."
    },
    {
      "path": "legends-footer.ts",
      "sets": ["leg"],
      "status": "weight-review",
      "finding": "Filled letters with perimeter thinning (artist .1px, P/T .3px), not hollow masks. Some artist strokes look heavier than the scan; retain the measured geometry while revisiting weight. Active Volcano audit input has a different printed artist name, so it cannot establish a typography score."
    },
    {
      "path": "canvas-text-ink.ts",
      "sets": ["plc"],
      "status": "no-hollow-path",
      "finding": "Colorshifted headings retain filled interiors after .25px inward thinning. Five color examples show no hollow-style recurrence. This audit does not recertify their frame texture or color."
    },
    {
      "path": "rules-paint.ts",
      "sets": ["lea"],
      "status": "no-hollow-path",
      "finding": "Only Alpha opts into .012em perimeter thinning. Filled text is the starting mask; no translated-mask hollow candidate is selected by the rules calibration."
    }
  ],
