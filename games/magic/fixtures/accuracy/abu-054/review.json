  "originalText": {
    "common": [
      "Original Drain Life cost is 1B; Oracle retains X1B.",
      "Wall of Wood and Wall of Stone have flavor only, without modern Defender reminders."
    ],
    "beta": [
      "Power Leak includes each turn.",
      "Basalt Monolith prints a plain 3 in the untap payment.",
      "Birds of Paradise retains its original left-aligned large paragraphs."
    ],
    "scope": "Exact printing IDs and scan hashes; Oracle remains independent."
  },
  "textPolicy": {
    "largeMaximumCharacters": 117,
    "largeMaximumMeasuredLines": 5,
    "mediumMaximumCharacters": 274,
    "originalRegularWidth": {
      "lea": {
        "under180": 8,
        "longer": 0
      },
      "leb": 8
    },
    "oracle": "Retains its independent safe fitting policy.",
    "manualReviews": "Content-matched existing small-text and optical alignment reviews remain scoped to the exact original passage."
  },
  "sourceConstraints": [
    "Existing frame textures and the missing secondary ABU inner-border details remain asset improvement work; the reconstructed Alpha frames stay experimental.",
    "Land-paper tint varies more strongly than colored spell paper. A pooled land-paper proposal regressed individual validation cards and was retained as a rejected candidate, rather than fitted per scan.",
    "Original manual typesetting can differ from a shared count/wrap rule. Reviewed residual outliers remain discoverable and are not hidden by scan-specific renderer offsets."
  ],
  "methodHash": "73428adc06f59eaffe7e509db0dbf6e2c1d38abc69928516a4692abacea084a9",
  "auditTasks": {
    "references": "All 597 original-printing inputs, scan hashes, basic/dual palettes and reviewed wording; original and Oracle isolation checked.",
    "normalization": "Independent frame-only affine fitting and separate certification strips; failed poses remain recorded and excluded from ranked means.",
    "frameGeometry": "Existing ABU plates, apertures, stock/corners, boxes and dual overlays inspected with frozen frame poses; retained source limitations are explicit.",
    "frameColor": "Per-material masked HSB and contrast audit, all available accepted printings. Alpha U/R and Beta U/G adopted; rejected proposals retained.",
    "paperColor": "Separate paper-mask audit; Beta G/R adjusted. Pooled land-paper proposal rejected for validation regressions.",
    "blackLevels": "Inner ink and outer stock measured independently. Dual-overlay stock now follows its base correction.",
    "manaGeometry": "54 preselected names per set; whole-cost translation/scale/spacing, per-color glyph geometry and generic numerals. Repeated whole-cost search after glyph adoption; cropped/full sampling parity verified.",
    "manaColor": "Disc paper and dark symbol ink separately measured against printing scans, final full-set audit repeated after glyph changes.",
    "headings": "Filled gray rather than hollow text, font/width/placement checks and full replay. Beta filled-ink gray diagnostic saved separately.",
    "rules": "Shared measured count/wrap tiers, predeclared width-bin search, exact-original optical exceptions, every-card replay and lowest-score outlier review.",
    "flavor": "Original paragraph roles, italic and attribution policy, spacing and shared safe fit replayed with body text; no Oracle wording substituted.",
    "artist": "Shared font, size, baseline and filled-gray treatment; independent stroke-interior gray measurements and every-card credits scores.",
    "footer": "Original illustrator copyright mark retained. Collector numbers, year line and trademarks intentionally absent for these original printings.",
    "stats": "Filled gray P/T, no hollow numbers; placement and source stats corrections reviewed, all applicable printings replayed.",
    "specialComponents": "Basic lands retain original textual mana wording rather than modern oversized glyph; dual striped paper and equal-band border treatment audited.",
    "fullCard": "597 native replays, unchanged-region checks through staged receipts, fixed-pose regional and whole-card scores; excluded scans and residual outliers preserved."
  }
